{
  "name": "@mchenziyi/dsh-summary-panel",
  "version": "0.3.4",
  "type": "module",
  "description": "DSH Reins (缰绳): a floating DSH panel where an agent-maintained task tree keeps long-running work on course, alongside Git, diffs, deliverables, subagents and sources.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "author": "mchenziyi",
  "homepage": "https://github.com/mchenziyi/dsh-summary-panel#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mchenziyi/dsh-summary-panel.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "summary-panel",
    "git",
    "diff",
    "task-tree",
    "todo",
    "reins"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "test": "node test/host.mjs && node test/tasks.mjs && node test/client.mjs"
  }
}
