#!/bin/sh
# main only moves through pull requests. The pre-commit hook refuses a commit on
# main; this one refuses the push as well, so a commit made with --no-verify (or
# before the guard existed) still cannot reach the remote's main branch.
set -e
cd "$(git rev-parse --show-toplevel)"

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      if [ "${REINS_ALLOW_MAIN_PUSH:-}" != "1" ]; then
        echo "pre-push: refusing to push ${local_ref:-HEAD} to ${remote_ref}." >&2
        echo "  open a pull request instead: git push -u origin <ticket-branch> && gh pr create." >&2
        echo "  (one-off override: REINS_ALLOW_MAIN_PUSH=1 git push ...)" >&2
        status=1
      fi
      ;;
  esac
done
exit "$status"
